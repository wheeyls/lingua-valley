{
  "name": "lingua-valley",
  "version": "0.1.0",
  "private": true,
  "description": "Learn Spanish through voice conversations in a point-and-click adventure.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "express": "^4.21.2",
    "openai": "^4.104.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@vercel/node": "^3.2.29",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
